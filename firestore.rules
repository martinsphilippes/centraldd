rules_version = '2';

// Regras de segurança do MLDisponibilidade.
// Cole este conteúdo em: Console do Firebase → Firestore Database → Regras → Publicar.
//
// Modelo de acesso:
//  - Coordenador: lê e escreve tudo (chamadas, motoristas, escalas, agenda, notificações).
//  - Motorista APROVADO: lê os dados da operação e só escreve a PRÓPRIA resposta/agenda.
//  - Pré-cadastro: qualquer conta pode criar o próprio cadastro (aprovado=false) e
//    o próprio perfil de motorista; só ganha acesso após aprovação do coordenador.
//  - Contas criadas no Console sem perfil viram coordenador no 1º login (e-mail autorizado).

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    // Dono da operação: único que decide quem vira COORDENADOR.
    function ehDono() {
      return logado() && request.auth.token.email == 'martinsphilippes@gmail.com';
    }

    function ehCoordenador() {
      return logado() &&
        get(/databases/$(database)/documents/perfis/$(request.auth.uid)).data.papel == 'coordenador';
    }

    // O cadastro de motorista da conta vem do PERFIL (motoristaId) — no
    // pré-cadastro ele é o próprio uid, mas a conta pode ser ligada a
    // qualquer cadastro existente pelo coordenador.
    function meuMotoristaId() {
      return get(/databases/$(database)/documents/perfis/$(request.auth.uid)).data.motoristaId;
    }

    // Motorista aprovado = o cadastro ligado à conta não tem aprovado=false.
    function motoristaAprovado() {
      let m = get(/databases/$(database)/documents/motoristas/$(meuMotoristaId())).data;
      return !('aprovado' in m) || m.aprovado == true;
    }

    match /perfis/{uid} {
      allow read: if logado();
      // Coordenador cria perfis; o e-mail do administrador cria o próprio perfil de
      // coordenador; e qualquer conta pode criar o PRÓPRIO perfil de motorista
      // (pré-cadastro — o acesso real só vem com a aprovação do cadastro).
      // Perfil de COORDENADOR: só o dono cria/muda. Coordenador comum mexe
      // apenas em perfil de motorista; e qualquer conta cria o próprio
      // perfil de motorista no pré-cadastro.
      allow create: if ehDono() ||
        (ehCoordenador() && request.resource.data.papel == 'motorista') ||
        (logado() && request.auth.uid == uid &&
         request.resource.data.papel == 'motorista' &&
         request.resource.data.motoristaId == uid);
      allow update: if ehDono() ||
        (ehCoordenador() && request.resource.data.papel == 'motorista' &&
         resource.data.papel == 'motorista');
      allow delete: if ehDono() ||
        (ehCoordenador() && resource.data.papel == 'motorista');
    }

    match /motoristas/{id} {
      allow read: if logado();
      // Pré-cadastro: a conta cria o próprio registro, obrigatoriamente com
      // aprovado=false e ativo=false — quem libera é o coordenador.
      allow create: if ehCoordenador() ||
        (logado() && request.auth.uid == id &&
         request.resource.data.aprovado == false &&
         request.resource.data.ativo == false);
      allow update, delete: if ehCoordenador();
      // O motorista ajusta as próprias preferências de cidade — e só elas.
      allow update: if logado() && id == meuMotoristaId() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['cidadesPreferidas', 'cidadesBloqueadas']);
    }

    match /chamadas/{id} {
      allow read: if logado();
      allow write: if ehCoordenador();
    }

    match /escalas/{id} {
      allow read: if logado();
      allow write: if ehCoordenador();
    }

    match /respostas/{id} {
      allow read: if logado();
      // Motorista aprovado grava apenas a própria resposta; coordenador pode tudo.
      allow write: if ehCoordenador() ||
        (logado() && request.resource.data.motoristaId == meuMotoristaId() && motoristaAprovado());
    }

    // Disponibilidade por data marcada pelo próprio motorista (agenda).
    match /agenda/{id} {
      allow read: if logado();
      allow create, update: if ehCoordenador() ||
        (logado() && request.resource.data.motoristaId == meuMotoristaId() && motoristaAprovado());
      allow delete: if ehCoordenador() ||
        (logado() && resource.data.motoristaId == meuMotoristaId());
    }

    match /rotas/{id} {
      allow read: if logado();
      allow write: if ehCoordenador();
      // O motorista finaliza a PRÓPRIA rota — e só pode mexer nesse campo.
      allow update: if logado() &&
        resource.data.motoristaId == meuMotoristaId() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['finalizadaEm']);
    }

    match /notificacoes/{id} {
      allow read: if logado();
      allow create: if ehCoordenador();
      allow update: if logado(); // marcar como lida
      allow delete: if ehCoordenador();
    }

    // Regra geral (vale para limites e para QUALQUER coleção nova do sistema):
    // todo usuário logado lê; apenas o coordenador escreve.
    // Coleções com escrita do motorista (respostas, agenda, pré-cadastro)
    // têm as permissões extras específicas definidas acima.
    match /{colecao}/{id} {
      allow read: if logado();
      allow write: if ehCoordenador();
    }
  }
}
