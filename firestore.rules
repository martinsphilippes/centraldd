rules_version = '2';

// Regras de segurança do MLDisponibilidade.
// Cole este conteúdo em: Console do Firebase → Firestore Database → Regras → Publicar.
//
// Modelo de acesso:
//  - Coordenador: lê e escreve tudo (chamadas, motoristas, escalas, agenda, notificações).
//  - Motorista APROVADO: lê os dados da operação e só escreve a PRÓPRIA resposta/agenda.
//  - Pré-cadastro: qualquer conta pode criar o próprio cadastro (aprovado=false) e
//    o próprio perfil de motorista; só ganha acesso após aprovação do coordenador.
//  - Contas criadas no Console sem perfil viram coordenador no 1º login (e-mail autorizado).

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function ehCoordenador() {
      return logado() &&
        get(/databases/$(database)/documents/perfis/$(request.auth.uid)).data.papel == 'coordenador';
    }

    // Motorista aprovado = tem cadastro próprio sem a marca aprovado=false.
    function motoristaAprovado() {
      let m = get(/databases/$(database)/documents/motoristas/$(request.auth.uid)).data;
      return !('aprovado' in m) || m.aprovado == true;
    }

    match /perfis/{uid} {
      allow read: if logado();
      // Coordenador cria perfis; o e-mail do administrador cria o próprio perfil de
      // coordenador; e qualquer conta pode criar o PRÓPRIO perfil de motorista
      // (pré-cadastro — o acesso real só vem com a aprovação do cadastro).
      allow create: if ehCoordenador() ||
        (logado() && request.auth.uid == uid &&
         request.auth.token.email == 'martinsphilippes@gmail.com') ||
        (logado() && request.auth.uid == uid &&
         request.resource.data.papel == 'motorista' &&
         request.resource.data.motoristaId == uid);
      allow update, delete: if ehCoordenador();
    }

    match /motoristas/{id} {
      allow read: if logado();
      // Pré-cadastro: a conta cria o próprio registro, obrigatoriamente com
      // aprovado=false e ativo=false — quem libera é o coordenador.
      allow create: if ehCoordenador() ||
        (logado() && request.auth.uid == id &&
         request.resource.data.aprovado == false &&
         request.resource.data.ativo == false);
      allow update, delete: if ehCoordenador();
    }

    match /chamadas/{id} {
      allow read: if logado();
      allow write: if ehCoordenador();
    }

    match /escalas/{id} {
      allow read: if logado();
      allow write: if ehCoordenador();
    }

    match /respostas/{id} {
      allow read: if logado();
      // Motorista aprovado grava apenas a própria resposta; coordenador pode tudo.
      allow write: if ehCoordenador() ||
        (logado() && request.resource.data.motoristaId == request.auth.uid && motoristaAprovado());
    }

    // Disponibilidade por data marcada pelo próprio motorista (agenda).
    match /agenda/{id} {
      allow read: if logado();
      allow create, update: if ehCoordenador() ||
        (logado() && request.resource.data.motoristaId == request.auth.uid && motoristaAprovado());
      allow delete: if ehCoordenador() ||
        (logado() && resource.data.motoristaId == request.auth.uid);
    }

    match /notificacoes/{id} {
      allow read: if logado();
      allow create: if ehCoordenador();
      allow update: if logado(); // marcar como lida
      allow delete: if ehCoordenador();
    }
  }
}
