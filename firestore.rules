rules_version = '2';

// Regras de segurança do Central DD.
// Cole este conteúdo em: Console do Firebase → Firestore Database → Regras → Publicar.
//
// Modelo de acesso:
//  - Dispatcher: lê e escreve tudo (chamadas, motoristas, planejamento,
//    disponibilidade, notificações).
//  - Motorista APROVADO: lê os dados da operação e só escreve a PRÓPRIA
//    resposta/disponibilidade.
//  - Pré-cadastro: qualquer conta pode criar o próprio cadastro (aprovado=false) e
//    o próprio perfil de motorista; só ganha acesso após aprovação do dispatcher.
//  - Contas criadas no Console sem perfil viram dispatcher no 1º login (e-mail autorizado).

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    // Dono da operação: único que decide quem vira DISPATCHER.
    function ehDono() {
      return logado() && request.auth.token.email == 'martinsphilippes@gmail.com';
    }

    // Aceita o papel novo ('dispatcher') e o legado ('coordenador'), gravado
    // nos perfis criados antes da renomeação — ninguém perde acesso.
    function ehDispatcher() {
      return logado() &&
        get(/databases/$(database)/documents/perfis/$(request.auth.uid)).data.papel in ['dispatcher', 'coordenador'];
    }

    // O cadastro de motorista da conta vem do PERFIL (motoristaId) — no
    // pré-cadastro ele é o próprio uid, mas a conta pode ser ligada a
    // qualquer cadastro existente pelo dispatcher.
    function meuMotoristaId() {
      return get(/databases/$(database)/documents/perfis/$(request.auth.uid)).data.motoristaId;
    }

    // Motorista aprovado = o cadastro ligado à conta não tem aprovado=false.
    function motoristaAprovado() {
      let m = get(/databases/$(database)/documents/motoristas/$(meuMotoristaId())).data;
      return !('aprovado' in m) || m.aprovado == true;
    }

    match /perfis/{uid} {
      allow read: if logado();
      // Dispatcher cria perfis; o e-mail do administrador cria o próprio perfil de
      // dispatcher; e qualquer conta pode criar o PRÓPRIO perfil de motorista
      // (pré-cadastro — o acesso real só vem com a aprovação do cadastro).
      // Perfil de DISPATCHER: só o dono cria/muda. Dispatcher comum mexe
      // apenas em perfil de motorista; e qualquer conta cria o próprio
      // perfil de motorista no pré-cadastro.
      allow create: if ehDono() ||
        (ehDispatcher() && request.resource.data.papel == 'motorista') ||
        (logado() && request.auth.uid == uid &&
         request.resource.data.papel == 'motorista' &&
         request.resource.data.motoristaId == uid);
      allow update: if ehDono() ||
        (ehDispatcher() && request.resource.data.papel == 'motorista' &&
         resource.data.papel == 'motorista');
      allow delete: if ehDono() ||
        (ehDispatcher() && resource.data.papel == 'motorista');
    }

    match /motoristas/{id} {
      allow read: if logado();
      // Pré-cadastro: a conta cria o próprio registro, obrigatoriamente com
      // aprovado=false e ativo=false — quem libera é o dispatcher.
      allow create: if ehDispatcher() ||
        (logado() && request.auth.uid == id &&
         request.resource.data.aprovado == false &&
         request.resource.data.ativo == false);
      allow update, delete: if ehDispatcher();
      // O motorista ajusta as próprias preferências de cidade e os próprios
      // dados de contato. Situação (ativo/aprovado/função) segue só do Dispatcher.
      allow update: if logado() && id == meuMotoristaId() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['cidadesPreferidas', 'cidadesPossiveis',
                    'nome', 'telefone', 'cidade', 'veiculo']);
    }

    match /chamadas/{id} {
      allow read: if logado();
      allow write: if ehDispatcher();
    }

    match /planejamento/{id} {
      allow read: if logado();
      allow write: if ehDispatcher();
    }

    match /respostas/{id} {
      allow read: if logado();
      // Motorista aprovado grava apenas a própria resposta; dispatcher pode tudo.
      allow write: if ehDispatcher() ||
        (logado() && request.resource.data.motoristaId == meuMotoristaId() && motoristaAprovado());
    }

    // Disponibilidade por data marcada pelo próprio motorista.
    match /disponibilidade/{id} {
      allow read: if logado();
      allow create, update: if ehDispatcher() ||
        (logado() && request.resource.data.motoristaId == meuMotoristaId() && motoristaAprovado());
      allow delete: if ehDispatcher() ||
        (logado() && resource.data.motoristaId == meuMotoristaId());
    }

    // Conferência de pacotes: o Dispatcher cria e mantém; o motorista da
    // conferência preenche APENAS o lado dele (a lista que enviou e o
    // carimbo de hora) — nunca a lista esperada nem a de outra pessoa.
    match /conferencias/{id} {
      allow read: if logado();
      allow write: if ehDispatcher();
      allow update: if logado() &&
        resource.data.motoristaId == meuMotoristaId() &&
        request.resource.data.motoristaId == resource.data.motoristaId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['conferidos', 'arquivoMotorista', 'conferidaEm', 'ocultaMotorista', 'roteiro']);
    }

    match /rotas/{id} {
      allow read: if logado();
      allow write: if ehDispatcher();
      // O motorista finaliza a PRÓPRIA rota — e só pode mexer nesse campo.
      allow update: if logado() &&
        resource.data.motoristaId == meuMotoristaId() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['finalizadaEm']);
    }

    // Opções de cadastro (veículos/operações): leitura PÚBLICA porque a tela
    // de cadastro roda antes do login; só o dispatcher escreve.
    match /tipos/{id} {
      allow read: if true;
      allow write: if ehDispatcher();
    }

    // Cidades da operação: leitura PÚBLICA pelo mesmo motivo de 'tipos' — o
    // campo de cidade do cadastro (antes do login) põe as cidades da
    // operação no topo da sugestão. Só o dispatcher escreve.
    match /cidades/{id} {
      allow read: if true;
      allow write: if ehDispatcher();
    }

    // CIDADE/OPERAÇÃO: os pares "cidade + operação" em que a pessoa atua,
    // perguntados no cadastro (antes do login, por isso leitura pública). Só
    // o DONO mantém a lista — dispatcher comum não cria nem apaga.
    match /operacoesCidade/{id} {
      allow read: if true;
      allow write: if ehDono();
    }

    // Sugestões de melhoria: o MOTORISTA escreve, o Dispatcher lê.
    // A leitura NÃO é liberada para motorista — nem a própria: a tela dele só
    // envia. Gente não escreve o que pensa sabendo que o colega pode ler.
    match /sugestoes/{id} {
      allow read: if ehDispatcher();
      allow create: if logado() && request.resource.data.motoristaId == meuMotoristaId();
      allow update, delete: if ehDispatcher();
    }

    match /notificacoes/{id} {
      allow read: if logado();
      allow create: if ehDispatcher();
      allow update: if logado(); // marcar como lida
      allow delete: if ehDispatcher();
    }

    // Regra geral (vale para limites e QUALQUER coleção nova):
    // todo usuário logado lê; apenas o dispatcher escreve.
    // ATENÇÃO: 'perfis' e 'operacoesCidade' ficam de fora da ESCRITA — uma
    // define quem é dispatcher, a outra é a lista que só o dono mantém, e
    // liberar aqui anularia a regra específica de cada uma (só o dono).
    // 'sugestoes' fica de fora da LEITURA: as regras se somam, então
    // sem esta exceção o `read: if logado()` daqui anularia o sigilo da regra
    // específica e todo motorista leria a sugestão de todo mundo.
    // Coleções com escrita do motorista (respostas, disponibilidade, rotas,
    // cadastro)
    // têm as permissões extras específicas definidas acima.
    match /{colecao}/{id} {
      allow read: if logado() && colecao != 'sugestoes';
      allow write: if ehDispatcher() && colecao != 'perfis' && colecao != 'operacoesCidade';
    }
  }
}
